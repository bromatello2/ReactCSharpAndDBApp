@page
@model ReactCSharpAndDBApp.Pages.LocationsModel
@{
    // Razor Page configuration for the title
    ViewData["Title"] = "WOW Locations";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>WOW Locations</title>
    <!-- Leaflet CSS for mapping -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <style>
        body { font-family: Arial, sans-serif; margin: 0; padding: 20px; }
        .container { max-width: 1200px; margin: 0 auto; }
        h1 { color: #333; }
        #map { height: 600px; width: 100%; margin: 20px 0; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); }
        .locations-list { margin-top: 30px; }
        .location-card { background: #f9f9f9; padding: 15px; margin: 10px 0; border-radius: 8px; border-left: 4px solid #0066cc; }
        .location-card h3 { margin: 0 0 10px 0; color: #0066cc; }
        .location-card p { margin: 5px 0; color: #666; }
        .loading { text-align: center; padding: 40px; color: #999; }
    </style>
</head>
<body>
    <div class="container">
        <h1>WOW Locations</h1>
        <p>Explore our locations on the map below:</p>
        
        <div id="loading" class="loading">Loading locations...</div>
        <div id="map" style="display: none;"></div>
        
        <div class="locations-list">
            <h2>Location Details</h2>
            <div id="locations-details"></div>
        </div>
    </div>

    <!-- Load the plain JavaScript application -->
    <script src="~/js/locationMap.js"></script>
</body>
</html>