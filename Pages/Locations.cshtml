@page
@model LocationsModel
@{
    // Razor Page configuration for the title
    ViewData["Title"] = "Global Locations";
}

<!-- Load Tailwind CSS (Assuming your project uses it or you have included it globally) -->
<script src="https://cdn.tailwindcss.com"></script>

<!-- The root element where React will mount the application -->
<div id="locations_root">
    <!-- Optional: Add a simple loading spinner here -->
    <div class="text-center p-20">
        <svg class="animate-spin h-8 w-8 text-indigo-500 mx-auto" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        <p class="text-gray-500 mt-3">Loading React Application...</p>
    </div>
</div>

<!-- Load React and ReactDOM from CDN -->
<script src="https://unpkg.com/react@18/umd/react.development.js" crossorigin></script>
<script src="https://unpkg.com/react-dom@18/umd/react-dom.development.js" crossorigin></script>

<!-- Load the React application script (use a compiled JS bundle) -->
<!-- Place the compiled bundle at wwwroot/js/locations.js -->
<script src="~/js/locations.js" type="module"></script>